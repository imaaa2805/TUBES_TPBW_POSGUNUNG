datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// TABEL 1: Puncak / Gunung di Pulau Jawa
// ============================================================
model Gunung {
  id             Int        @id @default(autoincrement())
  nama           String     // Contoh: Gunung Lawu, Gunung Merbabu, Gunung Semeru
  slug           String     @unique // contoh: gunung-lawu, gunung-merbabu
  provinsi       String     // Jawa Barat, Jawa Tengah, Jawa Timur, DIY
  kabupaten      String     // Magetan, Boyolali, Lumajang, dll
  ketinggian     Int        // MDPL, contoh: 3265, 3145, 3676
  statusVulkanik String     @default("Normal") // Normal, Waspada Level 2, Siaga Level 3, Awas
  statusJalur    String     @default("Buka")   // Buka, Waspada, Tutup
  tipeGunung     String     @default("Stratovolcano Tipe-A")
  kuotaHarian    Int        @default(250)
  kuotaTersisa   Int        @default(150)
  cuacaSuhu      Int        @default(14)       // Celsius
  cuacaKondisi   String     @default("Cerah Berawan")
  latitude       Float?     // Koordinat titik puncak / representatif
  longitude      Float?
  deskripsi      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  basecamps      Basecamp[]

  @@index([provinsi])
  @@index([statusJalur])
  @@index([statusVulkanik])
}

// ============================================================
// TABEL 2: Basecamp Jalur Pendakian
// ============================================================
model Basecamp {
  id           Int           @id @default(autoincrement())
  gunungId     Int
  nama         String        // Contoh: Basecamp Cemoro Sewu, Basecamp Selo
  jalurVia     String        // Contoh: Cemoro Sewu, Selo, Patakbanteng
  totalPos     Int           @default(0)
  status       String        @default("Buka") // Buka, Waspada, Tutup
  latitude     Float
  longitude    Float
  elevasi      Int?          @default(1800) // MDPL basecamp
  kontak       String?       // Nomor HP / WA Pengelola Basecamp
  simaksiInfo  String?       // Info registrasi SIMAKSI online/offline
  sumber       String?       // Catatan / sumber data
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  gunung       Gunung        @relation(fields: [gunungId], references: [id], onDelete: Cascade)
  pos          PosGunung[]
  logPembaruan LogPembaruan[]

  @@index([gunungId])
  @@index([status])
  @@index([jalurVia])
}

// ============================================================
// TABEL 3: Pos Pendakian / Shelter / Titik Mata Air / Puncak
// ============================================================
model PosGunung {
  id          Int      @id @default(autoincrement())
  basecampId  Int
  namaPos     String   // Contoh: Pos 1 Wesen-Wesen, Pos 2 Watu Gedheg, Mata Air Cetho
  urutan      Int      @default(1) // 1, 2, 3, 4, dst.
  latitude    Float
  longitude   Float
  elevasi     Int?     // MDPL perkiraan
  adaAir      Boolean  @default(false) // Indikator sumber mata air
  areaCamp    Boolean  @default(true)  // Cocok untuk mendirikan tenda
  keterangan  String?
  sumber      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  basecamp    Basecamp @relation(fields: [basecampId], references: [id], onDelete: Cascade)

  @@index([basecampId])
  @@index([adaAir])
  @@index([urutan])
}

// ============================================================
// TABEL 4: Log Audit & Pembaruan Status
// ============================================================
model LogPembaruan {
  id          Int       @id @default(autoincrement())
  basecampId  Int?
  posId       Int?
  fieldDiubah String
  nilaiLama   String?
  nilaiBaru   String?
  diubahOleh  String    @default("Petugas Geospasial")
  keterangan  String?
  createdAt   DateTime  @default(now())

  basecamp    Basecamp? @relation(fields: [basecampId], references: [id], onDelete: Cascade)

  @@index([basecampId])
  @@index([createdAt])
}
